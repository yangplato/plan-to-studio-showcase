  "facts": [
    {
      "room": "材质",
      "fact": "枝影落在木面上，几根细茎从灰褐色瓶口探出",
      "image_ids": [
        "cover-material"
      ]
    },
    {
      "room": "平面",
      "fact": "从平面上看，长方餐桌夹在厨房与客厅之间，两条长边各排三把椅子",
      "image_ids": [
        "color-plan"
      ]
    },
    {
      "room": "客厅",
      "fact": "从客厅望进去，视线先经过低茶几和浅色沙发，再抵达后方的餐桌",
      "image_ids": [
        "living-wide"
      ]
    },
    {
      "room": "客厅",
      "fact": "单椅的后腿向外斜出，扶手的木边接住窗光",
      "image_ids": [
        "window-chair",
        "woven-rug"
      ]
    },
    {
      "room": "客厅",
      "fact": "木格栅从电视背后竖起，一道细长的火光横过下方的深色凹槽",
      "image_ids": [
        "tv-front"
      ]
    },
    {
      "room": "客厅",
      "fact": "两层木搁板横过竖向格栅",
      "image_ids": [
        "shelf-objects"
      ]
    },
    {
      "room": "主卧",
      "fact": "床靠在木色墙面前，床尾的浅色织毯垂向地面",
      "image_ids": [
        "bedroom-wide"
      ]
    },
    {
      "room": "主卧",
      "fact": "近看床头背后的木面，深色细纹自上而下延伸，几块板之间留下笔直的接缝",
      "image_ids": [
        "headboard-grain"
      ]
    },
    {
      "room": "主卧",
      "fact": "陶土色靠枕压在橄榄绿床品前，枕面的折痕把同一种颜色分成明暗几层",
      "image_ids": [
        "clay-cushions",
        "knit-throw"
      ]
    },
    {
      "room": "主卧",
      "fact": "最后一个近景留给衣柜",
      "image_ids": [
        "wardrobe"
      ]
    }
  ],
