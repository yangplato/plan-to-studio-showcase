{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "case-manifest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "area_m2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "layout": {
      "type": "string",
      "minLength": 1
    },
    "color_plan": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "palette": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^#[0-9A-Fa-f]{6}$"
      },
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "raw": {
            "type": "string",
            "minLength": 1,
            "pattern": "^raw/[a-z0-9-]+\\.(png|jpg|jpeg|webp)$"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "dhash": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{16}$"
          },
          "size": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "crop_box": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 4,
            "maxItems": 4
          },
          "adopted": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "output": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^assets/4k/[a-z0-9-]+\\.png$"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_size": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "scale": {
            "type": "integer",
            "minimum": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "raw",
          "sha256",
          "dhash",
          "size",
          "crop_box",
          "adopted",
          "reason",
          "output",
          "output_size",
          "scale",
          "candidates"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "adopted": {
              "const": true
            }
          }
        },
        "then": {
          "properties": {
            "reason": {
              "type": "null"
            },
            "output": {
              "type": "string",
              "minLength": 1,
              "pattern": "^assets/4k/[a-z0-9-]+\\.png$"
            },
            "output_size": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "else": {
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "type": "null"
            },
            "output_size": {
              "type": "null"
            }
          }
        }
      },
      "minItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "room": {
            "type": "string",
            "minLength": 1
          },
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "image_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "room",
          "fact",
          "image_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "mirror_cover": {
      "type": "boolean"
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 22
      },
      "minItems": 1,
      "maxItems": 6
    },
    "route": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 22
      },
      "minItems": 1,
      "maxItems": 6
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 42
      },
      "minItems": 10,
      "maxItems": 10
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "focus": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "fraction": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5
    },
    "guide": {
      "type": "object",
      "patternProperties": {
        "^p(?:0[1-9]|10)$": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 26
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "area_m2",
    "layout",
    "color_plan",
    "palette",
    "assets",
    "facts"
  ],
  "additionalProperties": false
}
